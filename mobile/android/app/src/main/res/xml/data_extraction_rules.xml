<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing from this app is included in cloud backups or device-to-device transfers.
     The user's library is encrypted on the phone and leaves it only through the app's own .agbackup export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
